DATABASE_URL=postgres://memorywall:devpassword@postgres:5432/memorywall?sslmode=disable
# S3-compatible storage: MinIO locally, Cloudflare R2 in production.
# S3_ENDPOINT is how the API reaches it, S3_PUBLIC_ENDPOINT is how browsers do.
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=memory-wall
SITE_URL=http://localhost:3000
ANTHROPIC_API_KEY=
# Set to true only behind a reverse proxy you control, so rate limits use
# the real client IP from X-Forwarded-For.
TRUST_PROXY_HEADERS=false
